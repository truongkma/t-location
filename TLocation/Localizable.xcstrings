          }
        }
      }
    },
    "Uses low-accuracy location to stay alive while simulating.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses low-accuracy location to stay alive while simulating."
          }
        },
