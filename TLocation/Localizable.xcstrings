    "TLocation %@ • iOS %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TLocation %@ • iOS %@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "TLocation %@ • iOS %@"
          }
        }
      }
    },
    "TLocation could not clear the simulated location (error %lld). It may already have been cleared.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TLocation could not clear the simulated location (error %lld). It may already have been cleared."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "TLocation không thể xoá vị trí giả lập (lỗi %lld). Có thể vị trí đã được xoá trước đó."
          }
        }
      }
    },
    "TLocation could not reach this device. Connect LocalDevVPN and make sure Wi-Fi is joined to a network. (%@)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TLocation could not reach this device. Connect LocalDevVPN and make sure Wi-Fi is joined to a network. (%@)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "TLocation không kết nối được tới thiết bị. Hãy bật LocalDevVPN và đảm bảo Wi-Fi đã vào mạng. (%@)"
          }
        }
      }
    },
    "TLocation could not simulate the location (error %lld). Make sure the device is connected and the Developer Disk Image (DDI) is mounted.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TLocation could not simulate the location (error %lld). Make sure the device is connected and the Developer Disk Image (DDI) is mounted."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "TLocation không thể giả lập vị trí (lỗi %lld). Hãy đảm bảo thiết bị đã kết nối và Developer Disk Image (DDI) đã được gắn."
          }
        }
      }
    },
    "TLocation expires in %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TLocation expires in %@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "TLocation sẽ hết hạn sau %@"
          }
        }
      }
    },
    "TLocation has expired": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TLocation has expired"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "TLocation đã hết hạn"
          }
        }
      }
    },
    "TLocation lost the location-simulation session on this device and could not rebuild it, so the position is no longer being kept up to date — the device has most likely returned to its real location. Nothing was sent to the device. Reconnect LocalDevVPN, then tap Retry to reconnect before simulating again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TLocation lost the location-simulation session on this device and could not rebuild it, so the position is no longer being kept up to date — the device has most likely returned to its real location. Nothing was sent to the device. Reconnect LocalDevVPN, then tap Retry to reconnect before simulating again."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "TLocation đã mất phiên giả lập vị trí trên thiết bị này và không thể tạo lại, nên vị trí không còn được cập nhật — nhiều khả năng thiết bị đã trở lại vị trí thật. Không có lệnh nào được gửi tới thiết bị. Hãy kết nối lại LocalDevVPN, rồi chạm Thử lại để kết nối trước khi giả lập lại."
          }
        }
      }
    },
    "TLocation needs a connection to this device before it can simulate a location.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TLocation needs a connection to this device before it can simulate a location."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "TLocation cần kết nối tới thiết bị trước khi có thể giả lập vị trí."
          }
        }
      }
    },
    "TLocation needs location access to find your current position. Note: while a simulated location is active, iOS reports the simulated position.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TLocation needs location access to find your current position. Note: while a simulated location is active, iOS reports the simulated position."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "TLocation cần quyền truy cập vị trí để tìm vị trí hiện tại của bạn. Lưu ý: khi đang giả lập vị trí, iOS sẽ báo về vị trí giả lập."
          }
        }
      }
    },
